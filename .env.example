# ---------------------------------------------------------------------------
# StarsTask environment template. Copy to apps/web/.env.local for local dev.
# Never commit real values. Never prefix a secret with NEXT_PUBLIC_.
# ---------------------------------------------------------------------------

# Supabase project URL (public, safe for the browser).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase publishable key (public, safe for the browser, protected by RLS).
# Use the "Publishable key" from Supabase dashboard > Project Settings > API.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Public site URL used for canonical links and OAuth redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Salt used when hashing client IPs for rate limiting. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RATE_LIMIT_SALT=replace_with_a_random_64_char_hex_string

# Optional distributed rate limiting (Upstash Redis). When both values are set
# the Postgres-backed limiter is bypassed. Server-only.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: enables the opt-in RLS integration test suite. Server-only.
# These are used by tests, never by the application runtime.
SUPABASE_TEST_URL=
SUPABASE_TEST_ANON_KEY=
SUPABASE_TEST_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Web Push (optional, but all five values must be set together).
# See docs/PUSH_NOTIFICATIONS.md. Generate VAPID keys with:
#   pnpm --filter @starstask/web exec web-push generate-vapid-keys
# VAPID_SUBJECT must be a mailto: or https: URI.
# ---------------------------------------------------------------------------

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Service-role key: used only by the cron reminder endpoint. Server-only.
SUPABASE_SERVICE_ROLE_KEY=

# Random bearer token Vercel Cron sends to /api/cron/deadline-reminders.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# ---------------------------------------------------------------------------
# Internal developer monitoring (optional).
#
# Comma-separated, server-only allowlist. /developer opens only for a verified
# Supabase session whose email matches an entry (case-insensitive). Leave this
# empty to keep developer monitoring closed for everyone. Never prefix it with
# NEXT_PUBLIC_. Auth admin reads and monitoring tables also require
# SUPABASE_SERVICE_ROLE_KEY. See docs/DEVELOPER_MONITORING.md.
# ---------------------------------------------------------------------------

DEVELOPER_EMAILS=

# ---------------------------------------------------------------------------
# Google Calendar sync (optional, but all four values must be set together).
# Leave every value empty to ship without the feature: the "Add to Google
# Calendar" link needs none of this and keeps working. See docs/SESSIONS.md.
#
# This is a SEPARATE OAuth client from the Supabase Google sign-in client.
# Signing in with Google does not grant calendar access.
# ---------------------------------------------------------------------------

# Google Cloud console > APIs & Services > Credentials > OAuth client ID.
GOOGLE_CALENDAR_CLIENT_ID=

GOOGLE_CALENDAR_CLIENT_SECRET=

# Must match the authorised redirect URI registered on that client exactly.
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:3000/api/integrations/google-calendar/callback

# 32 random bytes, base64. Encrypts the stored refresh/access tokens (AES-256-GCM).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotating this value invalidates every stored connection; users reconnect once.
GOOGLE_TOKEN_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Leave-request document reader (optional).
# See docs/LEAVE_REQUESTS.md.
#
# `pdf-text` reads the text layer of an uploaded PDF locally. It needs no
# credentials and no network call. Set `disabled` to turn it off: every upload
# then records `not_run` and students type the values by hand, which is always
# supported. An unrecognised value is treated as disabled rather than silently
# falling back, so a typo cannot change behaviour.
# ---------------------------------------------------------------------------

OCR_PROVIDER=pdf-text
