# ---------------------------------------------------------------------------
# StarsTask environment template. Copy to apps/web/.env.local for local dev.
# Never commit real values. Never prefix a secret with NEXT_PUBLIC_.
# ---------------------------------------------------------------------------

# Supabase project URL (public, safe for the browser).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase publishable key (public, safe for the browser, protected by RLS).
# Use the "Publishable key" from Supabase dashboard > Project Settings > API.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Public site URL used for canonical links and OAuth redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional public contact address shown on the Privacy and Terms pages. Leave
# empty to omit the mailto link; set a real, monitored address before launch.
NEXT_PUBLIC_CONTACT_EMAIL=

# Salt used when hashing client IPs for rate limiting. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RATE_LIMIT_SALT=replace_with_a_random_64_char_hex_string

# Optional distributed rate limiting (Upstash Redis). When both values are set
# the Postgres-backed limiter is bypassed. Server-only.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: enables the opt-in RLS integration test suite. Server-only.
# These are used by tests, never by the application runtime.
SUPABASE_TEST_URL=
SUPABASE_TEST_ANON_KEY=
SUPABASE_TEST_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Web Push (optional, but all five values must be set together).
# See docs/PUSH_NOTIFICATIONS.md. Generate VAPID keys with:
#   pnpm --filter @starstask/web exec web-push generate-vapid-keys
# VAPID_SUBJECT must be a mailto: or https: URI.
# ---------------------------------------------------------------------------

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Service-role key: used only by the cron reminder endpoint. Server-only.
SUPABASE_SERVICE_ROLE_KEY=

# Random bearer token Vercel Cron sends to the /api/cron/* routes.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# Check-in coordinate retention window in days (default 30, allowed 1-3650).
# Coordinates are cleared after the session ends; status, distance, and accuracy
# stay. See docs/SESSIONS.md.
ATTENDANCE_RETENTION_DAYS=30

# Reminder-ledger retention window in days (default 180, allowed 1-3650).
# Terminal rows (sent, failed, skipped) are deleted; pending and processing
# rows are kept. See docs/PUSH_NOTIFICATIONS.md.
NOTIFICATION_RETENTION_DAYS=180

# Optional module switches. Every flag defaults to on; set to false, 0, off, no,
# or disabled to hide the module and refuse its API routes. These are public,
# build-time values: change them and rebuild. They are not authorization checks.
NEXT_PUBLIC_FEATURE_OCR=true
NEXT_PUBLIC_FEATURE_CALENDAR_SYNC=true
NEXT_PUBLIC_FEATURE_SESSION_CHECKIN=true

# UNPAM/FTI campus plugin (server-only kill-switch, default on).
# Set to false, 0, off, no, or disabled to hide University Info menus/pages.
# Status ditampilkan di Settings > Plugins (platform admin only).
UNPAM_PLUGIN_ENABLED=true

# ---------------------------------------------------------------------------
# Internal developer monitoring (optional).
#
# Comma-separated, server-only allowlist. /developer opens only for a verified
# Supabase session whose email matches an entry (case-insensitive). Leave this
# empty to keep developer monitoring closed for everyone. Never prefix it with
# NEXT_PUBLIC_. Auth admin reads and monitoring tables also require
# SUPABASE_SERVICE_ROLE_KEY. See docs/DEVELOPER_MONITORING.md.
# ---------------------------------------------------------------------------

DEVELOPER_EMAILS=

# ---------------------------------------------------------------------------
# Google Calendar sync (optional, but all four values must be set together).
# Leave every value empty to ship without the feature: the "Add to Google
# Calendar" link needs none of this and keeps working. See docs/SESSIONS.md.
#
# This is a SEPARATE OAuth client from the Supabase Google sign-in client.
# Signing in with Google does not grant calendar access.
# ---------------------------------------------------------------------------

# Google Cloud console > APIs & Services > Credentials > OAuth client ID.
GOOGLE_CALENDAR_CLIENT_ID=

GOOGLE_CALENDAR_CLIENT_SECRET=

# Must match the authorised redirect URI registered on that client exactly.
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:3000/api/integrations/google-calendar/callback

# 32 random bytes, base64. Encrypts the stored refresh/access tokens (AES-256-GCM).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotating this value invalidates every stored connection; users reconnect once.
GOOGLE_TOKEN_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Leave-request document reader (optional).
# See docs/LEAVE_REQUESTS.md.
#
# `pdf-text` reads the text layer of an uploaded PDF locally. It needs no
# credentials and no network call. Set `disabled` to turn it off: every upload
# then records `not_run` and students type the values by hand, which is always
# supported. An unrecognised value is treated as disabled rather than silently
# falling back, so a typo cannot change behaviour.
# ---------------------------------------------------------------------------

OCR_PROVIDER=pdf-text

# ---------------------------------------------------------------------------
# Error tracking and tracing (optional — Sentry).
# When `NEXT_PUBLIC_SENTRY_DSN` is empty the SDK is inert: no errors are
# reported and behaviour is identical to having no Sentry installed. The DSN
# is a public client key, safe to ship in the browser bundle. Errors carry
# no PII (sendDefaultPii is off); Session Replay and User Feedback are not
# enabled. Create a project at sentry.io to get a DSN.
# `SENTRY_ORG`, `SENTRY_PROJECT`, and `SENTRY_AUTH_TOKEN` are needed only for
# source-map upload in CI — never commit the token. See
# docs/DEVELOPER_MONITORING.md if it grows beyond this summary.
# ---------------------------------------------------------------------------

NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ---------------------------------------------------------------------------
# Product analytics and feature flags (optional — PostHog).
# Leave `NEXT_PUBLIC_POSTHOG_KEY` empty to disable analytics completely.
# Session recording and autocapture are off in code; pageviews carry the
# pathname only. `NEXT_PUBLIC_POSTHOG_HOST` defaults to the US cloud host;
# set it to your EU endpoint (https://eu.i.posthog.com) when needed.
# ---------------------------------------------------------------------------

NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# ---------------------------------------------------------------------------
# Cloudflare R2 (free: 10GB storage, $0 egress) — opsional, fallback Supabase Storage
# Buat bucket di Cloudflare Dashboard > R2 > Create Bucket, lalu isi API token.
# ---------------------------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=starstask-attachments
R2_PUBLIC_URL=
